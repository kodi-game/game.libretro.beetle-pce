msgid "CD Bios (Restart Required)"
msgstr "BIOS CD (Es requereix reinici)"

msgctxt "#30035"
msgid "Arcade Card (Restart Required)"
msgstr "Targeta Arcade (Es requereix reinici)"

msgctxt "#30036"
msgid "(CD) CD Speed"
msgstr "Velocitat del CD (CD)"

msgctxt "#30037"
msgid "(CD) ADPCM precision"
msgstr "Precisió ADPCM CD"

