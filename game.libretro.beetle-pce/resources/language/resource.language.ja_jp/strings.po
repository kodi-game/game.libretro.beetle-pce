msgid "Arcade Card (Restart Required)"
msgstr "アーケードカード (再起動が必要)"

msgctxt "#30036"
msgid "(CD) CD Speed"
msgstr "(CD) CD 速度"

msgctxt "#30037"
msgid "(CD) ADPCM precision"
msgstr "(CD) ADPCM 精度"

