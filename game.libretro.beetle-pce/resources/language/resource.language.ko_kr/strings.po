msgstr "Owl 리샘플러 품질"

msgctxt "#30010"
msgid "Show Advanced Input/Turbo Settings"
msgstr "고급 입력/터보 설정 표시"

msgctxt "#30011"
msgid "Mouse Sensitivity"
msgstr "마우스 감도"

msgctxt "#30012"
msgid "Allow Opposing Directions"
msgstr "반대 방향 동시 입력 허용"

msgctxt "#30013"
msgid "Disable Soft Reset (RUN+SELECT)"
msgstr "소프트 리셋 비활성화 (RUN+SELECT)"

msgctxt "#30014"
msgid "Multitap 5-port Controller"
msgstr "멀티탭 5포트 컨트롤러"

